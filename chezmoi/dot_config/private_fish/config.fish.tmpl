# EXPORT
set fish_greeting
set TERM "xterm-256color"

# Sets the terminal type
{{- if eq .osid "linux-manjaro" }}
set --export PYENV_ROOT $HOME/.pyenv
{{- end }}
# set VIRSH_DEFAULT_CONNECT_URI "qemu:///system"
set VIRSH_DEFAULT_CONNECT_URI qemu:///system
export VIRSH_DEFAULT_CONNECT_URI=qemu:///system

{{- if eq .osid "darwin" }}
# Homebrew: official prefix first. Leftover ~/.local/homebrew is only
# used if /opt/homebrew and /usr/local are absent.
# Ansible never writes shell rc; this is the Chezmoi equivalent of
# `eval "$(brew shellenv)"`.
if test -x /opt/homebrew/bin/brew
    eval (/opt/homebrew/bin/brew shellenv)
else if test -x /usr/local/bin/brew
    eval (/usr/local/bin/brew shellenv)
else if test -x ~/.local/homebrew/bin/brew
    eval (~/.local/homebrew/bin/brew shellenv)
end
{{- end }}

# mise: CLI tools (global config) + project toolchains/tasks.
# curl-bootstrap at ~/.local/bin; OS package on PATH after first apply.
# Prefer PATH so the pacman/brew mise wins over a leftover curl install.
if command -q mise
    mise activate fish | source
else if test -x ~/.local/bin/mise
    ~/.local/bin/mise activate fish | source
end

# AUTOCOMPLETE AND HIGHLIGHT COLORS
set fish_color_normal brcyan
set fish_color_autosuggestion '#7d7d7d'
set fish_color_command brcyan
set fish_color_error '#ff6c6b'
set fish_color_param brcyan

# Editor
set -gx EDITOR "nvim"

# GHQ Variables
set GHQ_ROOT '~/Repositories'

# Zellij Variables
set ZELLIJ_AUTO_ATTACH true
# set ZELLIJ_AUTO_EXIT false

if status is-interactive
    # Read the content of terminal.sh into a variable
    set terminal_name (cat ~/.config/.settings/terminal.sh | string trim)

    if test "$TERM_PROGRAM" = $terminal_name
        eval (zellij setup --generate-auto-start fish | string collect)
    end

    # Initialize television (hackable fuzzy finder)
    tv init fish | source

end


# Aliases
alias grep='grep --color=auto'

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias .3='cd ../../..'

alias ls='eza -l'
alias lt='ls --tree'
alias weather='curl wttr.in'
alias btop='btop --force-utf'
alias nv='nvim'
alias lg='lazygit'
alias cza='chezmoi add'

# confirm before overwriting something
# alias cp="cp -i"
# alias mv='mv -i'
alias rm='rm -i'

# SETTING THE STARSHIP PROMPT
starship init fish | source


{{- if eq .osid "linux-manjaro" }}
# pyenv init
status is-login; and pyenv init --path | source
status is-interactive; and pyenv init - | source
set PATH $PYENV_ROOT/shims:$PATH
{{- end }}

# zoxide
zoxide init fish | source
alias cd="z"

# atuin (SQL Database to search history)
atuin init fish | source

# uv
fish_add_path "/home/ms-garuda/.local/bin"
