#!/bin/bash

# omarchy:summary=Returns a weather condition icon from linecast.

place=""
if [[ -s "$HOME/.local/state/quickshell/settings/weather.json" ]]; then
  place=$(omarchy-weather-location 2>/dev/null)
fi

args=(weather --json --icons nerd)
if [[ -n $place ]]; then
  args+=(--location "$place")
fi

icon=$(omarchy-linecast "${args[@]}" 2>/dev/null | jq -er '.current.icon | select(. != null and . != "")' 2>/dev/null) || exit 1
printf '%s\n' "$icon"
