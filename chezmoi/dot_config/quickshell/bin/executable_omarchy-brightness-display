#!/bin/bash
# Show or adjust display brightness with brightnessctl / ddcutil.

set -euo pipefail

no_osd=0
monitor=""

while (( $# > 0 )); do
  case "$1" in
    --no-osd) no_osd=1; shift ;;
    --monitor)
      (( $# >= 2 )) || exit 1
      monitor="$2"
      shift 2
      ;;
    *) break ;;
  esac
done

config="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
export PATH="$config/bin:${PATH:-/usr/bin}"

current_percent() {
  if command -v brightnessctl >/dev/null 2>&1; then
    brightnessctl -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; exit }'
  fi
}

show_osd() {
  (( no_osd == 0 )) || return 0
  local percent=${1:-0}
  command -v omarchy-osd >/dev/null 2>&1 && omarchy-osd -i brightness -p "$percent" || true
}

if (( $# == 0 )); then
  current_percent
  exit 0
fi

step=$1

if [[ $step == "off" ]]; then
  hyprctl dispatch dpms off >/dev/null 2>&1 || true
  exit 0
elif [[ $step == "on" ]]; then
  hyprctl dispatch dpms on >/dev/null 2>&1 || true
  exit 0
fi

if command -v brightnessctl >/dev/null 2>&1; then
  brightnessctl set "$step" >/dev/null
  percent=$(current_percent)
  show_osd "${percent:-0}"
  echo "${percent:-}"
  exit 0
fi

if command -v ddcutil >/dev/null 2>&1 && [[ -n $monitor ]]; then
  echo "ddcutil brightness for $monitor is not wired; install brightnessctl" >&2
  exit 1
fi

echo "brightnessctl is not installed" >&2
exit 1
