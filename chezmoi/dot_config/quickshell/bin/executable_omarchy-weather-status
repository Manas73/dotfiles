#!/bin/bash

# omarchy:summary=Returns a formatted weather status string with temperature and wind speed.

place=$(omarchy-weather-location 2>/dev/null)
args=(weather --oneline --icons nerd)
if [[ -n $place ]]; then
  args+=(--location "$place")
fi

status=$(omarchy-linecast "${args[@]}" 2>/dev/null | tr -d '\n')
if [[ -z $status ]]; then
  echo "Weather unavailable"
  exit 1
fi

echo "$status"
