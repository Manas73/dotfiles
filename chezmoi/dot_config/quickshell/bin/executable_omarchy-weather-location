#!/bin/bash

# omarchy:summary=Show or set the location used for weather reports
#
# State lives in ~/.local/state/quickshell/settings/weather.json as a home
# location plus optional extra place tabs:
#   {"name", "latitude", "longitude", "places":[...], "activePlaceId"}
# A missing file means the home tab is auto-detected from the IP address.
#
#   (no args)           the current home location: the stored name, or the
#                       IP-detected city when nothing is set
#   --set <name> [lat,lon]  store the home location (extra tabs are kept)
#   --clear             return the home tab to IP auto-detect (extra tabs stay)

LOC_FILE="$HOME/.local/state/quickshell/settings/weather.json"
COORDS_PATTERN='^(-?[0-9]+(\.[0-9]+)?),(-?[0-9]+(\.[0-9]+)?)$'

merge_home() {
  local name=$1
  local lat=$2
  local lon=$3
  local existing="{}"
  [[ -f $LOC_FILE ]] && existing=$(cat "$LOC_FILE")
  if [[ -n $lat && -n $lon ]]; then
    jq -n --argjson existing "$existing" --arg name "$name" --argjson latitude "$lat" --argjson longitude "$lon" '
      ($existing | if type == "object" then . else {} end) as $e |
      ($e.places // []) as $places |
      {
        name: $name,
        latitude: $latitude,
        longitude: $longitude,
        activePlaceId: ($e.activePlaceId // "home"),
        places: (
          if ($places | length) == 0 then
            [{id: "home", name: $name, latitude: $latitude, longitude: $longitude}]
          else
            $places | .[0].id = (.[0].id // "home") | .[0].name = $name | .[0].latitude = $latitude | .[0].longitude = $longitude
          end
        )
      }
    '
  else
    jq -n --argjson existing "$existing" --arg name "$name" '
      ($existing | if type == "object" then . else {} end) as $e |
      ($e.places // []) as $places |
      {
        name: $name,
        activePlaceId: ($e.activePlaceId // "home"),
        places: (
          if ($places | length) == 0 then
            [{id: "home", name: $name}]
          else
            $places | .[0].id = (.[0].id // "home") | .[0].name = $name | del(.[0].latitude, .[0].longitude)
          end
        )
      }
    '
  fi
}

case "${1:-}" in
"")
  name=""
  [[ -f $LOC_FILE ]] && name=$(jq -r '.name // "" | if type == "string" then . else "" end' "$LOC_FILE" 2>/dev/null)
  if [[ -z $name ]]; then
    name=$(curl -fsS --max-time 4 "https://wttr.in/?format=%l" 2>/dev/null)
    name=${name%%,*}
  fi
  [[ -n $name ]] && echo "$name"
  ;;
--set)
  [[ -n ${2:-} ]] || { echo "Usage: omarchy-weather-location --set <name> [lat,lon]" >&2; exit 1; }
  if [[ -n ${3:-} ]]; then
    [[ ${3} =~ $COORDS_PATTERN ]] || { echo "Invalid coordinates: $3 (expected lat,lon)" >&2; exit 1; }
    location=$(merge_home "$2" "${3%,*}" "${3#*,}")
  else
    location=$(merge_home "$2" "" "")
  fi
  mkdir -p "$(dirname "$LOC_FILE")"
  echo "$location" >"$LOC_FILE"
  ;;
--clear)
  if [[ -f $LOC_FILE ]] && jq -e '(.places | length) > 1' "$LOC_FILE" >/dev/null 2>&1; then
    location=$(merge_home "" "" "")
    echo "$location" >"$LOC_FILE"
  else
    rm -f "$LOC_FILE"
  fi
  ;;
*)
  echo "Usage: omarchy-weather-location [--set <name> [lat,lon]|--clear]" >&2
  exit 1
  ;;
esac
