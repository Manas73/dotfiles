{{/* skhd config — macOS counterpart to the Hyprland keybinds.

Window management is handled by omniwm (~/.config/omniwm/settings.toml) on the
Hyper key; this only mirrors the NON-window-management Hyprland binds:
  * application launchers  (hypr/keybinds/private_applications.lua)
  * submap menus           (hypr/keybinds/private_submaps.lua)
Every bind shells out to ~/.config/.settings/*.sh, exactly like Hyprland. Those
scripts are chezmoi-rendered per OS/host, so the actual mac app lives there.

mainMod: Hyprland SUPER -> cmd + ctrl on macOS (kept distinct from omniwm's
Hyper = ctrl + alt + cmd so the two don't collide).

Submaps use skhd modes (`@` captures every key while active). An skhd action is
EITHER a command (`: cmd`) OR a mode switch (`; mode`), never both. To emulate
Hyprland's "run then auto-reset", each action runs its script and then chains
`skhd -k "escape"`, which triggers the mode's `escape ; default` binding to
return to the default mode. */ -}}
{{- $mainMod := "cmd + ctrl" -}}
{{- $s := "$HOME/.config/.settings" -}}
{{- $notify := "osascript -e" -}}
# ==============================================================================
# skhd — generated by chezmoi. Do not edit ~/.config/skhd/skhdrc directly.
# ==============================================================================

# ------------------------------------------------------------------------------
# Mode declarations. `@` captures all keys while the mode is active; the
# trailing command runs on entry (used here to show a notification hint).
# ------------------------------------------------------------------------------
:: default
:: menus @ : {{ $notify }} 'display notification "a audio  m mic  b bluetooth  c clipboard  v vpn  w wifi  (esc)" with title "skhd: menus"'
:: ide   @ : {{ $notify }} 'display notification "1 editor  2 ide  (esc)" with title "skhd: ide"'

# ------------------------------------------------------------------------------
# Application launchers (Hyprland: mainMod + Return/D/B/M/G, + Delete).
# ------------------------------------------------------------------------------
{{ $mainMod }} - return : {{ $s }}/terminal.sh
{{ $mainMod }} - d      : {{ $s }}/file_manager.sh
{{ $mainMod }} - b      : {{ $s }}/browser.sh
{{ $mainMod }} - m      : {{ $s }}/work_messenger.sh
{{ $mainMod }} - g      : {{ $s }}/git_client.sh
{{ $mainMod }} - delete : {{ $s }}/powermenu.sh

# Hyprland mainMod + Space is `rofi -show drun`. macOS uses Spotlight/Alfred; no
# bind here so those are not shadowed.

# ------------------------------------------------------------------------------
# "Rofi" menus submap — Hyprland: mainMod + altMod + Space.
# Entry switches into `menus`; each key runs a script then `skhd -k "escape"`
# fires the `escape ; default` binding below to leave the mode.
# ------------------------------------------------------------------------------
{{ $mainMod }} - space ; menus

menus < a : {{ $s }}/audio_menu.sh        ; skhd -k "escape"
menus < m : {{ $s }}/microphone_menu.sh   ; skhd -k "escape"
menus < b : {{ $s }}/bluetooth_menu.sh    ; skhd -k "escape"
menus < c : {{ $s }}/clipboard-wayland.sh ; skhd -k "escape"
menus < v : {{ $s }}/vpn_menu.sh          ; skhd -k "escape"
menus < w : {{ $s }}/wifi_menu.sh         ; skhd -k "escape"
menus < escape ; default

# ------------------------------------------------------------------------------
# IDE submap — Hyprland: SUPER + C, then 1/2.
# ------------------------------------------------------------------------------
{{ $mainMod }} - c ; ide

ide < 1 : {{ $s }}/editor.sh ; skhd -k "escape"
ide < 2 : {{ $s }}/ide.sh    ; skhd -k "escape"
ide < escape ; default
