            "complex_modifications": {
                "rules": [
                    {
                        "description": "Left Command as Hyper, with Cmd+Q and Cmd+Opt+Space passthrough",
                        "manipulators": [
                            {
                                "description": "Track whether left_option is physically held.",
                                "from": {
                                    "key_code": "left_option",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "physical_option",
                                            "value": 1
                                        }
                                    },
                                    { "key_code": "left_option" }
                                ],
                                "to_after_key_up": [
                                    {
                                        "set_variable": {
                                            "name": "physical_option",
                                            "value": 0
                                        }
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Hyper+Q -> Cmd+Q (quit app).",
                                "from": {
                                    "key_code": "q",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option"] }
                                },
                                "to": [
                                    {
                                        "key_code": "q",
                                        "modifiers": ["left_command"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "physical_option",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "description": "Hyper + physical Option + Space -> Cmd+Opt+Space.",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": { "mandatory": ["left_command", "left_control", "left_option"] }
                                },
                                "to": [
                                    {
                                        "key_code": "spacebar",
                                        "modifiers": ["left_command", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Change left_command to command+control+option.",
                                "from": {
                                    "key_code": "left_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_command",
                                        "modifiers": ["left_control", "left_option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
