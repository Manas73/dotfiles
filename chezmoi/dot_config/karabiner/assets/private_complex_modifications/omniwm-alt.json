{
  "title": "OmniWM: Left Option = workspaces 6-10",
  "rules": [
    {
      "description": "Left Opt+1-5 -> WS 6-10, Left Opt+Shift+1-5 -> move to WS 6-10",
      "manipulators": [
        { "type": "basic", "from": { "key_code": "1", "modifiers": { "mandatory": ["left_option", "shift"] } }, "to": [{ "key_code": "6", "modifiers": ["left_control", "left_option", "left_command", "left_shift"] }] },
        { "type": "basic", "from": { "key_code": "2", "modifiers": { "mandatory": ["left_option", "shift"] } }, "to": [{ "key_code": "7", "modifiers": ["left_control", "left_option", "left_command", "left_shift"] }] },
        { "type": "basic", "from": { "key_code": "3", "modifiers": { "mandatory": ["left_option", "shift"] } }, "to": [{ "key_code": "8", "modifiers": ["left_control", "left_option", "left_command", "left_shift"] }] },
        { "type": "basic", "from": { "key_code": "4", "modifiers": { "mandatory": ["left_option", "shift"] } }, "to": [{ "key_code": "9", "modifiers": ["left_control", "left_option", "left_command", "left_shift"] }] },
        { "type": "basic", "from": { "key_code": "5", "modifiers": { "mandatory": ["left_option", "shift"] } }, "to": [{ "shell_command": "/opt/homebrew/bin/omniwmctl command move-to-workspace 10" }] },

        { "type": "basic", "from": { "key_code": "1", "modifiers": { "mandatory": ["left_option"] } }, "to": [{ "key_code": "6", "modifiers": ["left_control", "left_option", "left_command"] }] },
        { "type": "basic", "from": { "key_code": "2", "modifiers": { "mandatory": ["left_option"] } }, "to": [{ "key_code": "7", "modifiers": ["left_control", "left_option", "left_command"] }] },
        { "type": "basic", "from": { "key_code": "3", "modifiers": { "mandatory": ["left_option"] } }, "to": [{ "key_code": "8", "modifiers": ["left_control", "left_option", "left_command"] }] },
        { "type": "basic", "from": { "key_code": "4", "modifiers": { "mandatory": ["left_option"] } }, "to": [{ "key_code": "9", "modifiers": ["left_control", "left_option", "left_command"] }] },
        { "type": "basic", "from": { "key_code": "5", "modifiers": { "mandatory": ["left_option"] } }, "to": [{ "shell_command": "/opt/homebrew/bin/omniwmctl command switch-workspace anywhere 10" }] },
        
        { "type": "basic", "from": { "key_code": "s", "modifiers": { "mandatory": ["control", "option", "command"] } }, "to": [{ "shell_command": "/opt/homebrew/bin/omniwmctl command switch-workspace anywhere 11" }] },
        { "type": "basic", "from": { "key_code": "s", "modifiers": { "mandatory": ["control", "option", "command", "shift"] } }, "to": [{ "shell_command": "/opt/homebrew/bin/omniwmctl command move-to-workspace 11" }] }
      ]
    }
  ]
}