{
  "title": "Linux-style Ctrl editing shortcuts",
  "rules": [
    {
      "description": "Ctrl for copy/paste/undo and text movement (terminals & PyCharm untouched)",
      "manipulators": [
        {
          "type": "basic",
          "description": "Terminal: Ctrl+Shift+C -> Cmd+C (copy)",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": [
                "control",
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "c",
              "modifiers": [
                "left_command"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.mitchellh\\.ghostty$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^(io|org)\\.alacritty$",
                "^dev\\.warp\\.Warp",
                "^com\\.jetbrains\\.pycharm"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "description": "Terminal: Ctrl+Shift+V -> Cmd+V (paste)",
